<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chris Mazzu Hockey Clinics | CoachesHuddle powered by Venuewise</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#0a1628;--navy2:#0d1e38;--navy3:#142444;--ice:#b8e4f5;--gold:#c9a227;--gold2:#e8bf45;--white:#f8fafc;--muted:#8fa3c0;--r:12px}
body{font-family:'DM Sans',sans-serif;background:var(--navy);color:var(--white);min-height:100vh}

/* NAV */
.nav{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;background:var(--navy2);border-bottom:1px solid rgba(184,228,245,0.1);position:sticky;top:0;z-index:100}
.nav-brand{display:flex;align-items:center;gap:16px}
.nav-logo{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:800;letter-spacing:1px;color:var(--white);text-decoration:none}
.nav-logo span{color:var(--gold)}
.nav-divider{width:1px;height:20px;background:rgba(184,228,245,0.2)}
.nav-powered{font-size:11px;color:var(--muted);letter-spacing:.5px}
.nav-powered a{color:var(--gold);text-decoration:none;font-weight:600}
.nav-tabs{display:flex;gap:4px}
.tab{font-size:12px;font-weight:500;padding:6px 14px;border-radius:20px;border:none;cursor:pointer;background:transparent;color:var(--muted);letter-spacing:.3px;transition:all .2s}
.tab.active{background:var(--gold);color:var(--navy);font-weight:700}
.tab:hover:not(.active){background:rgba(184,228,245,0.08);color:var(--ice)}
.homehuddle-link{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--ice);background:rgba(184,228,245,0.08);border:1px solid rgba(184,228,245,0.2);border-radius:20px;padding:6px 14px;text-decoration:none;transition:all .2s}
.homehuddle-link:hover{background:rgba(184,228,245,0.15);color:var(--white)}

/* PAGES */
.page{display:none;animation:fadeIn .3s ease}
.page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

/* LANDING */
.hero{padding:56px 32px 48px;text-align:center;background:linear-gradient(160deg,var(--navy2) 0%,var(--navy3) 100%);border-bottom:1px solid rgba(184,228,245,0.08)}
.hero-badge{display:inline-block;font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);background:rgba(201,162,39,0.12);border:1px solid rgba(201,162,39,0.3);border-radius:20px;padding:5px 14px;margin-bottom:20px}
.hero-name{font-family:'Barlow Condensed',sans-serif;font-size:72px;font-weight:800;line-height:1;letter-spacing:2px;color:#ffffff}
.hero-subtitle{font-family:'Barlow Condensed',sans-serif;font-size:38px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-top:6px;margin-bottom:16px}
.hero-desc{font-size:16px;color:var(--muted);max-width:500px;margin:0 auto 32px;line-height:1.6}
.btn-primary{display:inline-block;font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700;letter-spacing:1px;text-transform:uppercase;background:var(--gold);color:var(--navy);border:none;border-radius:8px;padding:14px 36px;cursor:pointer;transition:all .2s;text-decoration:none}
.btn-primary:hover{background:var(--gold2);transform:translateY(-1px)}
.btn-secondary{display:inline-block;font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;background:transparent;color:var(--ice);border:1px solid rgba(184,228,245,0.3);border-radius:8px;padding:12px 28px;cursor:pointer;transition:all .2s;text-decoration:none;margin-left:12px}
.btn-secondary:hover{background:rgba(184,228,245,0.08);border-color:rgba(184,228,245,0.5)}
.hero-stats{display:flex;justify-content:center;gap:48px;margin-top:48px;padding-top:32px;border-top:1px solid rgba(184,228,245,0.08)}
.stat-num{font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:800;color:var(--gold)}
.stat-label{font-size:12px;color:var(--muted);margin-top:2px}

.features{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:32px}
.feat-card{background:var(--navy2);border:1px solid rgba(184,228,245,0.1);border-radius:var(--r);padding:24px}
.feat-icon{width:44px;height:44px;border-radius:10px;background:rgba(201,162,39,0.12);display:flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:22px}
.feat-title{font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:700;color:var(--white);margin-bottom:8px}
.feat-desc{font-size:13px;color:var(--muted);line-height:1.6}

/* HOMEHUDDLE CONNECT BANNER */
.connect-banner{margin:0 32px 32px;background:linear-gradient(135deg,rgba(184,228,245,0.06) 0%,rgba(201,162,39,0.06) 100%);border:1px solid rgba(184,228,245,0.15);border-radius:var(--r);padding:24px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.cb-left{display:flex;align-items:center;gap:16px}
.cb-icon{width:48px;height:48px;border-radius:10px;background:rgba(184,228,245,0.1);border:1px solid rgba(184,228,245,0.2);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.cb-title{font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:700;color:var(--white);margin-bottom:4px}
.cb-desc{font-size:13px;color:var(--muted)}
.cb-desc a{color:var(--gold);text-decoration:none;font-weight:600}

/* REGISTRATION */
.reg-wrap{padding:32px;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
.prog-badge{display:inline-block;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--ice);background:rgba(184,228,245,0.1);border:1px solid rgba(184,228,245,0.2);border-radius:4px;padding:3px 10px;margin-bottom:12px}
.reg-title{font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:800;margin-bottom:8px;line-height:1.1}
.prog-card{background:var(--navy2);border:1px solid rgba(184,228,245,0.1);border-radius:var(--r);padding:14px 16px;cursor:pointer;margin-bottom:10px;transition:all .2s}
.prog-card.selected{border-color:var(--gold);background:rgba(201,162,39,0.08)}
.prog-card:hover:not(.selected){border-color:rgba(184,228,245,0.25)}
.prog-card-top{display:flex;justify-content:space-between;align-items:center}
.prog-name{font-weight:600;font-size:14px}
.prog-price{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;color:var(--gold)}
.prog-detail{font-size:12px;color:var(--muted);margin-top:4px}
.sync-note{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:12px;color:var(--muted)}
.sync-dot{width:8px;height:8px;background:#22c55e;border-radius:50%;flex-shrink:0;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.form-panel{background:var(--navy2);border:1px solid rgba(184,228,245,0.1);border-radius:var(--r);padding:24px}
.form-title{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;margin-bottom:20px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.form-row.full{grid-template-columns:1fr}
.form-group{display:flex;flex-direction:column;gap:5px}
.form-group label{font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}
.form-group input,.form-group select{background:var(--navy3);border:1px solid rgba(184,228,245,0.12);border-radius:8px;padding:10px 12px;font-size:13px;color:var(--white);font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;width:100%}
.form-group input:focus,.form-group select:focus{border-color:rgba(201,162,39,0.5)}
.form-group select option{background:var(--navy2)}
.reg-btn{width:100%;margin-top:16px;font-size:16px;padding:14px;border-radius:8px;letter-spacing:.5px}

/* CONFIRMATION */
.confirm-wrap{padding:48px 32px;text-align:center;max-width:700px;margin:0 auto}
.check-circle{width:88px;height:88px;border-radius:50%;background:rgba(34,197,94,0.12);border:2px solid rgba(34,197,94,0.4);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:40px}
.confirm-title{font-family:'Barlow Condensed',sans-serif;font-size:42px;font-weight:800;margin-bottom:8px}
.confirm-sub{font-size:15px;color:var(--muted);margin-bottom:32px}
.confirm-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:32px;text-align:left}
.cc{background:var(--navy2);border:1px solid rgba(184,228,245,0.1);border-radius:var(--r);padding:16px}
.cc-label{font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.cc-val{font-size:14px;font-weight:500}
.sms-bubble{background:var(--navy2);border:1px solid rgba(184,228,245,0.1);border-radius:16px;padding:20px;text-align:left;margin-bottom:28px}
.sms-from{font-size:11px;color:var(--muted);margin-bottom:8px;display:flex;align-items:center;gap:6px}
.sms-green{width:8px;height:8px;background:#22c55e;border-radius:50%}
.sms-body{font-size:13px;line-height:1.6}
.sms-time{font-size:11px;color:var(--muted);margin-top:8px}

/* HOMEHUDDLE CTA */
.hh-cta{background:linear-gradient(135deg,rgba(184,228,245,0.08) 0%,rgba(201,162,39,0.08) 100%);border:1px solid rgba(184,228,245,0.2);border-radius:var(--r);padding:28px;text-align:center;margin-bottom:24px}
.hh-cta-title{font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800;margin-bottom:8px}
.hh-cta-desc{font-size:14px;color:var(--muted);margin-bottom:20px;line-height:1.6}
.hh-cta-steps{display:flex;justify-content:center;gap:24px;margin-bottom:24px}
.hh-step{text-align:center}
.hh-step-num{width:32px;height:32px;border-radius:50%;background:var(--gold);color:var(--navy);font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 8px}
.hh-step-text{font-size:12px;color:var(--muted);max-width:100px}

/* DASHBOARD */
.dash-wrap{padding:24px}
.dash-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.dash-title{font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:800}
.welcome-badge{font-size:12px;color:var(--gold);background:rgba(201,162,39,0.1);border:1px solid rgba(201,162,39,0.25);border-radius:20px;padding:4px 12px}
.next-session{background:rgba(201,162,39,0.06);border:1px solid rgba(201,162,39,0.2);border-radius:var(--r);padding:20px;margin-bottom:20px}
.ns-label{font-size:10px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--gold);margin-bottom:6px}
.ns-name{font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:800;margin-bottom:4px}
.ns-meta{font-size:13px;color:var(--muted)}
.ns-countdown{display:flex;gap:12px;margin-top:14px}
.ns-unit{text-align:center;background:var(--navy3);border-radius:6px;padding:8px 14px;min-width:52px}
.ns-num{font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800}
.ns-lbl{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.dash-panel{background:var(--navy2);border:1px solid rgba(184,228,245,0.1);border-radius:var(--r);padding:18px}
.panel-title{font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.event-item{display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-bottom:1px solid rgba(184,228,245,0.06)}
.event-item:last-child{border-bottom:none;padding-bottom:0}
.event-date{background:var(--navy3);border-radius:8px;padding:6px 10px;text-align:center;min-width:46px;flex-shrink:0}
.event-month{font-size:9px;font-weight:600;text-transform:uppercase;color:var(--gold);letter-spacing:.5px}
.event-day{font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:800;line-height:1}
.event-info{flex:1}
.event-name{font-size:13px;font-weight:600;margin-bottom:2px}
.event-meta{font-size:11px;color:var(--muted)}
.event-tag{font-size:10px;font-weight:600;padding:2px 8px;border-radius:4px;margin-left:auto;flex-shrink:0;align-self:center}
.tag-skills{background:rgba(184,228,245,0.1);color:var(--ice);border:1px solid rgba(184,228,245,0.2)}
.tag-elite{background:rgba(201,162,39,0.1);color:var(--gold);border:1px solid rgba(201,162,39,0.25)}
.tag-goalie{background:rgba(139,92,246,0.1);color:#c4b5fd;border:1px solid rgba(139,92,246,0.25)}
.notif-item{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid rgba(184,228,245,0.06)}
.notif-item:last-child{border-bottom:none;padding-bottom:0}
.ni-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:15px}
.notif-text{font-size:12px;line-height:1.5;flex:1}
.notif-time{font-size:10px;color:var(--muted);flex-shrink:0}
.mini-map{background:var(--navy3);border-radius:8px;padding:12px;margin-top:10px;display:flex;align-items:center;gap:10px}
.map-info{flex:1}
.map-name{font-size:12px;font-weight:600}
.map-addr{font-size:11px;color:var(--muted)}
.map-btn{font-size:11px;font-weight:600;color:var(--gold);background:none;border:none;cursor:pointer}

/* HOMEHUDDLE PANEL IN DASHBOARD */
.hh-panel{background:linear-gradient(135deg,rgba(184,228,245,0.05) 0%,rgba(201,162,39,0.05) 100%);border:1px solid rgba(184,228,245,0.15);border-radius:var(--r);padding:18px;margin-top:0}
.hh-panel-title{font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px}
.hh-panel-desc{font-size:12px;color:var(--muted);margin-bottom:14px}
.hh-panel-btn{display:inline-block;font-size:13px;font-weight:600;color:var(--navy);background:var(--gold);border:none;border-radius:6px;padding:8px 16px;cursor:pointer;text-decoration:none;transition:all .2s}
.hh-panel-btn:hover{background:var(--gold2)}

/* NOTIFICATIONS */
.notif-wrap{padding:28px 32px}
.notif-wrap h2{font-family:'Barlow Condensed',sans-serif;font-size:30px;font-weight:800;margin-bottom:4px}
.notif-sub{font-size:13px;color:var(--muted);margin-bottom:24px}
.big-notif{background:var(--navy2);border:1px solid rgba(184,228,245,0.1);border-radius:var(--r);padding:18px;display:flex;gap:14px;align-items:flex-start;margin-bottom:12px}
.bn-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:22px}
.bn-body{flex:1}
.bn-type{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px}
.bn-msg{font-size:14px;font-weight:500;margin-bottom:4px}
.bn-detail{font-size:12px;color:var(--muted)}
.bn-time{font-size:11px;color:var(--muted);margin-top:8px}
.sms-label{font-size:10px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--muted);margin:10px 0 4px}
.sms-preview{background:var(--navy3);border-radius:8px;padding:10px 12px;font-size:12px;color:#d6f0fb;border-left:2px solid rgba(184,228,245,0.3);line-height:1.5}

/* FOOTER */
.footer{padding:24px 32px;border-top:1px solid rgba(184,228,245,0.08);display:flex;align-items:center;justify-content:space-between;margin-top:32px}
.footer-logo{font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:var(--muted)}
.footer-logo span{color:var(--gold)}
.footer-links{display:flex;gap:20px}
.footer-links a{font-size:12px;color:var(--muted);text-decoration:none;transition:color .2s}
.footer-links a:hover{color:var(--white)}
.footer-copy{font-size:11px;color:var(--muted)}
</style>
</head>
<body>

<!-- NAV -->
<div class="nav">
  <div class="nav-brand">
    <a href="/" class="nav-logo">Coaches<span>Huddle</span></a>
    <div class="nav-divider"></div>
    <div class="nav-powered">powered by <a href="https://venuewise.net">Venuewise</a></div>
  </div>
  <div class="nav-tabs">
    <button class="tab active" onclick="showPage('landing',this)">Landing</button>
    <button class="tab" onclick="showPage('reg',this)">Register</button>
    <button class="tab" onclick="showPage('confirm',this)">Confirm</button>
    <button class="tab" onclick="showPage('dash',this)">Dashboard</button>
    <button class="tab" onclick="showPage('notif',this)">Alerts</button>
  </div>
  <a href="https://venuewise.net/homehuddle" class="homehuddle-link">🏠 HomeHuddle</a>
</div>

<!-- LANDING -->
<div class="page active" id="page-landing">
  <div class="hero">
    <div class="hero-badge">⬡ CoachesHuddle · Powered by Venuewise</div>
    <div class="hero-name">CHRIS MAZZU</div>
    <div class="hero-subtitle">Hockey Clinics</div>
    <p class="hero-desc">Register once. Your family schedule syncs automatically to HomeHuddle. Never miss a session, a change, or an open spot.</p>
    <button class="btn-primary" onclick="showPage('reg',document.querySelectorAll('.tab')[1])">View Clinics & Register →</button>
    <a href="https://venuewise.net/homehuddle" class="btn-secondary">View Family Dashboard</a>
    <div class="hero-stats">
      <div class="stat-item"><div class="stat-num">3</div><div class="stat-label">Active Programs</div></div>
      <div class="stat-item"><div class="stat-num">120+</div><div class="stat-label">Families Enrolled</div></div>
      <div class="stat-item"><div class="stat-num">0</div><div class="stat-label">Manual Updates Needed</div></div>
    </div>
  </div>

  <div class="features">
    <div class="feat-card">
      <div class="feat-icon">📅</div>
      <div class="feat-title">Instant Schedule Sync</div>
      <div class="feat-desc">Register and every session instantly appears in your HomeHuddle family dashboard — no copy-paste, no manual entry required.</div>
    </div>
    <div class="feat-card">
      <div class="feat-icon">🔔</div>
      <div class="feat-title">Smart Notifications</div>
      <div class="feat-desc">SMS and push reminders for upcoming sessions, rink changes, weather cancellations, and open spots — automatically.</div>
    </div>
    <div class="feat-card">
      <div class="feat-icon">📍</div>
      <div class="feat-title">Rink Navigation</div>
      <div class="feat-desc">Every session includes the rink address with one-tap directions. Always know exactly where to be and when.</div>
    </div>
  </div>

  <div class="connect-banner">
    <div class="cb-left">
      <div class="cb-icon">🏠</div>
      <div>
        <div class="cb-title">Already have a HomeHuddle account?</div>
        <div class="cb-desc">Your Chris Mazzu clinic schedule will <strong>automatically sync</strong> to your existing family dashboard the moment you register. <a href="https://venuewise.net/homehuddle">Sign in to HomeHuddle →</a></div>
      </div>
    </div>
    <a href="https://venuewise.net/homehuddle" class="btn-primary" style="white-space:nowrap;font-size:14px;padding:10px 24px">Open HomeHuddle</a>
  </div>
</div>

<!-- REGISTRATION -->
<div class="page" id="page-reg">
  <div class="reg-wrap">
    <div>
      <div class="prog-badge">2025 Clinic Programs</div>
      <h2 class="reg-title">Chris Mazzu<br>Hockey Clinics</h2>
      <p style="font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.55">Elite on-ice training for skaters at every level. Select a program and register in under 2 minutes.</p>
      <div class="prog-card selected" onclick="selectProg(this)">
        <div class="prog-card-top"><span class="prog-name">Summer Skills Camp</span><span class="prog-price">$349</span></div>
        <div class="prog-detail">6 sessions · June 9 – July 14 · Ages 8–14 · Mon 6:00 PM</div>
      </div>
      <div class="prog-card" onclick="selectProg(this)">
        <div class="prog-card-top"><span class="prog-name">Elite Power Skating</span><span class="prog-price">$249</span></div>
        <div class="prog-detail">4 sessions · July 7 – July 28 · Ages 10–16 · Mon 5:30 PM</div>
      </div>
      <div class="prog-card" onclick="selectProg(this)">
        <div class="prog-card-top"><span class="prog-name">Goalie Clinic</span><span class="prog-price">$199</span></div>
        <div class="prog-detail">3 sessions · Aug 4 – Aug 18 · All ages · Mon 4:00 PM</div>
      </div>
      <div class="sync-note">
        <div class="sync-dot"></div>
        Schedule auto-syncs to your HomeHuddle family dashboard on registration
      </div>
    </div>
    <div class="form-panel">
      <div class="form-title">Register & Sync Schedule</div>
      <div class="form-row">
        <div class="form-group"><label>Parent name</label><input type="text" placeholder="First Last"></div>
        <div class="form-group"><label>Player name</label><input type="text" placeholder="First Last"></div>
